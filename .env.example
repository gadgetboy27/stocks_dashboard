# Stock API Configuration
#
# Get your free API key from Alpha Vantage: https://www.alphavantage.co/support/#api-key
# The demo key only works with limited symbols (IBM, MSFT, etc.)
# For full access to all stock symbols, get your own free API key (5 API calls/min, 500 calls/day)

REACT_APP_ALPHA_VANTAGE_KEY=demo

# Optional: Finnhub API Key (if you want to use Finnhub instead)
# Get your free API key from: https://finnhub.io/register
# Free tier: 60 API calls/minute

REACT_APP_FINNHUB_KEY=

# Instructions:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Replace 'demo' with your actual API key
# 3. Restart your development server (npm start)
